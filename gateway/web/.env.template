# Eleball-claw Web 环境变量模板
# 复制本文件为 .env 后填入实际值

# 本地 claw gateway 基础路径（对话/视觉/模型/技能/Agent/对话历史/同步/STT）
# 开发时由 Vite 代理到本机 claw-server（默认 :8090）
VITE_API_BASE=/api

# 云端 eleball API（账户/充值/支付/VIP/CDK/秘技购买/已购秘技拉取）
VITE_CLOUD_API=https://api.eleball.cn/v1

# 云端 eleball web（首页/文档/充值页面整页跳转）
VITE_CLOUD_BASE=https://www.eleball.cn
