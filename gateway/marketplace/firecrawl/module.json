{
  "id": "firecrawl",
  "name": "Firecrawl 网页抓取",
  "description": "网页抓取、批量爬取、结构化数据提取。Docker MCP HTTP 模块，调用 Firecrawl API（须配 API Key）。",
  "source": "marketplace",
  "source_origin": "eleball_cloud",
  "transport": "mcp_http",
  "deployment": "docker",
  "endpoint": "http://localhost:8095",
  "docker_compose_path": "marketplace/firecrawl/docker-compose.yml",
  "sku_scope": "claw",
  "auto_sku": true,
  "mcp_server_config": {
    "url": "http://localhost:8095",
    "headers": {
      "X-Firecrawl-Key": "${credentials.firecrawl_api_key}"
    }
  },
  "credentials": {
    "firecrawl_api_key": {
      "type": "api_key",
      "label": "Firecrawl API Key",
      "description": "用于调用 Firecrawl Cloud API，可从 https://firecrawl.dev 获取。",
      "placeholder": "fc-...",
      "required": true,
      "scope": "module"
    }
  },
  "capabilities": ["scrape", "crawl", "extract"],
  "driver": {
    "driver_id": "firecrawl",
    "name": "Firecrawl 网页抓取",
    "description": "网页抓取、批量爬取、结构化数据提取"
  }
}
